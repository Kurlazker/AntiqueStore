<Window x:Class="AntiqueStore.PL.EditItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование антиквариата" 
        Height="420" Width="420"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: ID -->
            <RowDefinition Height="Auto"/>
            <!-- 1: ID значение -->
            <RowDefinition Height="10"/>
            <!-- 2: отступ -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Тип -->
            <RowDefinition Height="Auto"/>
            <!-- 4: ComboBox -->
            <RowDefinition Height="10"/>
            <!-- 5: отступ -->
            <RowDefinition Height="Auto"/>
            <!-- 6: Название -->
            <RowDefinition Height="Auto"/>
            <!-- 7: TextBox Название -->
            <RowDefinition Height="10"/>
            <!-- 8: отступ -->
            <RowDefinition Height="Auto"/>
            <!-- 9: Год -->
            <RowDefinition Height="Auto"/>
            <!-- 10: TextBox Год -->
            <RowDefinition Height="10"/>
            <!-- 11: отступ -->
            <RowDefinition Height="Auto"/>
            <!-- 12: Цена -->
            <RowDefinition Height="Auto"/>
            <!-- 13: TextBox Цена -->
            <RowDefinition Height="10"/>
            <!-- 14: отступ -->
            <RowDefinition Height="Auto"/>
            <!-- 15: Художник/Страна -->
            <RowDefinition Height="Auto"/>
            <!-- 16: TextBox Details -->
            <RowDefinition Height="*"/>
            <!-- 17: свободное место -->
            <RowDefinition Height="Auto"/>
            <!-- 18: Кнопки -->
        </Grid.RowDefinitions>

        <!-- ID -->
        <TextBlock Text="ID:" Grid.Row="0" FontWeight="Bold"/>
        <TextBlock x:Name="IdText" Grid.Row="1" Foreground="Gray"/>

        <!-- Тип предмета -->
        <TextBlock Text="Тип предмета:" Grid.Row="3" FontWeight="Bold"/>
        <ComboBox x:Name="TypeComboBox" Grid.Row="4" SelectedIndex="0">
            <ComboBoxItem Content="Картина"/>
            <ComboBoxItem Content="Монета"/>
        </ComboBox>

        <!-- Название -->
        <TextBlock Text="Название:" Grid.Row="6" FontWeight="Bold"/>
        <TextBox x:Name="NameBox" Grid.Row="7" Height="25"/>

        <!-- Год -->
        <TextBlock Text="Год:" Grid.Row="9" FontWeight="Bold"/>
        <TextBox x:Name="YearBox" Grid.Row="10" Height="25"/>

        <!-- Цена -->
        <TextBlock Text="Цена (руб.):" Grid.Row="12" FontWeight="Bold"/>
        <TextBox x:Name="PriceBox" Grid.Row="13" Height="25"/>

        <!-- Художник / Страна -->
        <TextBlock Text="Художник (для картины) или Страна (для монеты):" 
                   Grid.Row="15" FontWeight="Bold"/>
        <TextBox x:Name="DetailsBox" Grid.Row="16" Height="25"/>

        <!-- Кнопки (в отдельной строке, ничего не перекрывают) -->
        <StackPanel Grid.Row="18" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="110" Height="35" 
                    Margin="0,0,10,0" Click="SaveButton_Click" 
                    Background="LightGreen" FontWeight="Bold"/>
            <Button Content="Отмена" Width="110" Height="35" 
                    Click="CancelButton_Click" 
                    Background="LightCoral" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>