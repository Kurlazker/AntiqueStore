<Window x:Class="AntiqueStore.PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Интернет-магазин антиквара"
        Height="550" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Кнопки управления -->
        <WrapPanel Grid.Row="0" HorizontalAlignment="Center" Margin="5">
            <Button Content="Добавить антиквариат" 
                    Command="{Binding AddCommand}"
                    Background="LightGreen" Width="180" Height="35" Margin="5"/>
            <Button Content="Удалить выбранное" 
                    Command="{Binding DeleteCommand}"
                    Background="LightCoral" Width="160" Height="35" Margin="5"/>
            <Button Content="Обновить" 
                    Command="{Binding RefreshCommand}"
                    Background="LightBlue" Width="120" Height="35" Margin="5"/>
        </WrapPanel>

        <!-- Поиск по названию -->
        <GroupBox Header="Поиск по названию" Grid.Row="1" Margin="5" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="5"/>
                <Button Grid.Column="1" 
                        Content="Найти" 
                        Command="{Binding SearchCommand}" 
                        Margin="5" Width="100"/>
            </Grid>
        </GroupBox>

        <!-- Таблица данных -->
        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="5"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="70"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N0} руб.}" Width="110"/>
                <DataGridTextColumn Header="Информация" Binding="{Binding FullInfo}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Статусная строка -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <TextBlock Text="Записей: " FontWeight="Bold"/>
            <TextBlock Text="{Binding TotalCount}" Margin="0,0,20,0" Foreground="DarkBlue"/>
            <TextBlock Text="Общая стоимость: " FontWeight="Bold"/>
            <TextBlock Text="{Binding TotalValue, StringFormat={}{0:N0} руб.}"
                       Foreground="DarkGreen" FontWeight="Bold" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>