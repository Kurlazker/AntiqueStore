<Window x:Class="AntiqueStore.PL.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление антиквариата" 
        Height="380" Width="420"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Тип -->
            <RowDefinition Height="10"/>
            <!-- отступ -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Название -->
            <RowDefinition Height="10"/>
            <!-- отступ -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Год -->
            <RowDefinition Height="10"/>
            <!-- отступ -->
            <RowDefinition Height="Auto"/>
            <!-- 6: Цена -->
            <RowDefinition Height="10"/>
            <!-- отступ -->
            <RowDefinition Height="Auto"/>
            <!-- 8: Доп. поле -->
            <RowDefinition Height="*"/>
            <!-- 9: распорка -->
            <RowDefinition Height="Auto"/>
            <!-- 10: Кнопки -->
        </Grid.RowDefinitions>

        <!-- Тип предмета -->
        <TextBlock Grid.Row="0" Text="Тип предмета:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" x:Name="TypeComboBox" SelectedIndex="0" Margin="120,0,0,0">
            <ComboBoxItem Content="Картина"/>
            <ComboBoxItem Content="Монета"/>
        </ComboBox>

        <!-- Название -->
        <TextBlock Grid.Row="2" Text="Название:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" x:Name="NameBox" Margin="120,0,0,0"/>

        <!-- Год -->
        <TextBlock Grid.Row="4" Text="Год:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" x:Name="YearBox" Margin="120,0,0,0"/>

        <!-- Цена -->
        <TextBlock Grid.Row="6" Text="Цена (руб.):" VerticalAlignment="Center"/>
        <TextBox Grid.Row="6" x:Name="PriceBox" Margin="120,0,0,0"/>

        <!-- Доп. поле (Художник/Страна) -->
        <TextBlock Grid.Row="8" Text="Художник / Страна:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="8" x:Name="DetailsBox" Margin="120,0,0,0"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" 
                    Width="100" Height="30" 
                    Margin="0,0,10,0"
                    Click="SaveButton_Click" 
                    Background="LightGreen"/>
            <Button Content="Отмена" 
                    Width="100" Height="30" 
                    Click="CancelButton_Click" 
                    Background="LightCoral"/>
        </StackPanel>
    </Grid>
</Window>